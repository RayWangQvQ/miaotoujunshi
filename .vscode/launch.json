{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① Jev Mac · 离线演示 (--demo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/integrations/jev_mac/app.py",
      "args": ["--demo"],
      "cwd": "${workspaceFolder}/integrations/jev_mac",
      "python": "${workspaceFolder}/integrations/jev_mac/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "② Jev Mac · 完整启动（真实读屏 + 模型）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/integrations/jev_mac/app.py",
      "args": [],
      "cwd": "${workspaceFolder}/integrations/jev_mac",
      "python": "${workspaceFolder}/integrations/jev_mac/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "③ Jev Mac · 直接打开设置",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/integrations/jev_mac/app.py",
      "args": ["--settings"],
      "cwd": "${workspaceFolder}/integrations/jev_mac",
      "python": "${workspaceFolder}/integrations/jev_mac/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "④ Jev Mac · 直接打开 K 线窗口",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/integrations/jev_mac/app.py",
      "args": ["--trend"],
      "cwd": "${workspaceFolder}/integrations/jev_mac",
      "python": "${workspaceFolder}/integrations/jev_mac/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑤ 跑全部单元测试 (tests/)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-q"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/integrations/jev_mac/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "⑥ Android · JVM 单元测试 (attach 5005)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "projectName": "jev-android",
      "preLaunchTask": "android: 单元测试挂起等待调试器"
    },
    {
      "name": "⑦ Android · attach 真机进程 (8700)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 8700,
      "projectName": "jev-android",
      "preLaunchTask": "android: 构建安装并建好调试通道"
    }
  ]
}
