# Flutter writes the plugin registrants with LF on every `pub get`, at any
# platform. The rest of the tree checks out as CRLF (core.autocrlf=true), so
# without this every build leaves these four files dirty with zero content
# change. Pinning them to LF makes the working copy match what Flutter
# produces and what the index already stores.
app/apps/*/macos/Flutter/GeneratedPluginRegistrant.swift  text eol=lf
app/apps/*/windows/flutter/generated_plugin_registrant.cc text eol=lf
app/apps/*/windows/flutter/generated_plugin_registrant.h  text eol=lf
app/apps/*/windows/flutter/generated_plugins.cmake        text eol=lf
